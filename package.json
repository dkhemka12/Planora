{
  "name": "planora-workspace",
  "version": "1.0.0",
  "description": "Planora — AI-Powered Study Planner",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "db:init": "npm --prefix server run db:init",
    "db:test": "npm --prefix server run db:test",
    "test:foundation": "npm --prefix server run test:foundation",
    "test:auth": "npm --prefix server run test:auth",
    "test:subjects": "npm --prefix server run test:subjects",
    "test:tasks": "npm --prefix server run test:tasks",
    "test:dashboard": "npm --prefix server run test:dashboard",
    "check:gemini": "npm --prefix server run check:gemini"
  },
  "keywords": [
    "study-planner",
    "ai",
    "react",
    "express",
    "mongodb",
    "postgresql"
  ],
  "author": "Planora Team",
  "license": "MIT"
}
